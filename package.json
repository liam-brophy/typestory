{
  "name": "typestory",
  "version": "0.1.0",
  "description": "A web e-reading framework with Pretext-driven typesetting, chapter progress and margin figures that can displace text.",
  "type": "module",
  "license": "MIT",
  "author": "Liam Brophy",
  "repository": { "type": "git", "url": "git+https://github.com/liam-brophy/typestory.git" },
  "main": "./dist/typestory.js",
  "module": "./dist/typestory.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/typestory.js" },
    "./style.css": "./dist/typestory.css"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "vite",
    "build": "vite build --config vite.lib.config.ts",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2"
  }
}
